{
  "__inputs": [
    {
      "name": "DS_OPENSEARCH",
      "label": "OpenSearch",
      "description": "Select your OpenSearch data source",
      "type": "datasource",
      "pluginId": "grafana-opensearch-datasource",
      "pluginName": "OpenSearch"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-opensearch-datasource",
      "name": "OpenSearch",
      "version": "2.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Total Logs Registered",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": "${DS_OPENSEARCH}",
      "targets": [
        {
          "alias": "Logs Totals",
          "bucketAggs": [
            {
              "field": "timestamp",
              "id": "2",
              "settings": {
                "interval": "auto"
              },
              "type": "date_histogram"
            }
          ],
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "*",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "🚨 Detected Anomalies (AI)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": "${DS_OPENSEARCH}",
      "targets": [
        {
          "alias": "Anomalies",
          "bucketAggs": [
            {
              "field": "timestamp",
              "id": "2",
              "settings": {
                "interval": "auto"
              },
              "type": "date_histogram"
            }
          ],
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "is_anomaly:true",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "System Errors & Criticals",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": "${DS_OPENSEARCH}",
      "targets": [
        {
          "alias": "Errors",
          "bucketAggs": [
            {
              "field": "timestamp",
              "id": "2",
              "settings": {
                "interval": "auto"
              },
              "type": "date_histogram"
            }
          ],
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "severity_name:(error OR critical OR emerg OR alert) OR severity_numeric:>=4",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "New Templates (Drain3)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": "${DS_OPENSEARCH}",
      "targets": [
        {
          "alias": "New Templates",
          "bucketAggs": [
            {
              "field": "timestamp",
              "id": "2",
              "settings": {
                "interval": "auto"
              },
              "type": "date_histogram"
            }
          ],
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "drain_change_type:cluster_created",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "📋 ANOMALY LOG AUDIT TABLE (Raw Logs)",
      "type": "table",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": "${DS_OPENSEARCH}",
      "targets": [
        {
          "refId": "A",
          "query": "is_anomaly:true",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "500"
              }
            }
          ],
          "bucketAggs": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "_id": true,
              "_index": true,
              "_type": true,
              "_score": true,
              "ml_prediction": true,
              "drain_cluster_id": true,
              "drain_parameter_count": true,
              "drain_cluster_size": true,
              "logs_per_minute": true,
              "errors_per_minute": true,
              "warnings_per_minute": true,
              "unique_templates_per_minute": true,
              "current_template_per_minute": true,
              "ml_features": true
            },
            "indexByName": {
              "timestamp": 0,
              "anomaly_level": 1,
              "anomaly_score": 2,
              "severity_name": 3,
              "drain_template": 4,
              "message": 5
            },
            "renameByName": {
              "timestamp": "Timestamp",
              "anomaly_level": "Anomaly Level",
              "anomaly_score": "Score (Isolation Forest)",
              "severity_name": "Severity",
              "drain_template": "Template (Drain3)",
              "message": "Raw Log Message"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Anomaly Level"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "gradient",
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": "medium"
                    },
                    {
                      "color": "orange",
                      "value": "high"
                    },
                    {
                      "color": "red",
                      "value": "critical"
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "CRITICAL 🟥",
                        "color": "red"
                      },
                      "high": {
                        "text": "HIGH 🟧",
                        "color": "orange"
                      },
                      "medium": {
                        "text": "MEDIUM 🟨",
                        "color": "yellow"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Score (Isolation Forest)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 4
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": -0.2
                    },
                    {
                      "color": "yellow",
                      "value": -0.1
                    },
                    {
                      "color": "green",
                      "value": 0
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Raw Log Message"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 600
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Template (Drain3)"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 400
              }
            ]
          }
        ]
      },
      "options": {
        "footer": {
          "enablePagination": true,
          "show": true,
          "reducer": [
            "count"
          ]
        },
        "showHeader": true
      }
    },
    {
      "id": 6,
      "title": "🔍 STREAMING RAW LOG EXPLORER (Interactive Viewer)",
      "type": "logs",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": "${DS_OPENSEARCH}",
      "targets": [
        {
          "refId": "A",
          "query": "is_anomaly:true",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "500"
              }
            }
          ],
          "bucketAggs": []
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showCommonLabels": false,
        "showTime": true
      }
    },
    {
      "id": 7,
      "title": "Anomaly Timeline (Score over Time)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": "${DS_OPENSEARCH}",
      "targets": [
        {
          "alias": "Score Anomalia",
          "bucketAggs": [
            {
              "field": "timestamp",
              "id": "2",
              "settings": {
                "interval": "auto"
              },
              "type": "date_histogram"
            }
          ],
          "metrics": [
            {
              "field": "anomaly_score",
              "id": "1",
              "type": "avg"
            }
          ],
          "query": "is_anomaly:true",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -0.2
              },
              {
                "color": "yellow",
                "value": -0.1
              },
              {
                "color": "green",
                "value": 0.0
              }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Anomaly Level by Severity",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": "${DS_OPENSEARCH}",
      "targets": [
        {
          "alias": "{{cell}}",
          "bucketAggs": [
            {
              "field": "anomaly_level.keyword",
              "id": "1",
              "settings": {
                "order": "desc",
                "orderBy": "_count",
                "size": "10"
              },
              "type": "terms"
            }
          ],
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "is_anomaly:true",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {}
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "proxmox",
    "logs",
    "ia",
    "anomaly-detection",
    "details"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "OpenSearch",
          "value": "DS_OPENSEARCH"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "name": "DS_OPENSEARCH",
        "options": [],
        "query": "grafana-opensearch-datasource",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource",
        "pluginId": "grafana-opensearch-datasource"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "browser",
  "title": "Proxmox VE - Real-Time Log Anomaly Dashboard",
  "uid": "proxmox-logs-detall-v1",
  "version": 1
}